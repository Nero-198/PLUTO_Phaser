# Measurement captures (raw IQ data, screenshots, and run logs)
/captures/

# Build products and downloaded/scratch dependencies
/build/
/out/
/cmake-build-*/
/tmp/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/Testing/
**/.ninja_*

# KiCad local state, locks, and automatic backups
/kicad/**/.history/
/kicad/**/*-backups/
/kicad/**/~*.lck
/kicad/**/*.kicad_prl
/kicad/**/*.kicad_pcb-bak
/kicad/**/*.kicad_sch-bak
/kicad/**/_autosave-*
